---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"    : {{ post.title | jsonify }},
      "subtitle" : {{ post.subtitle | jsonify }},
      "tags"     : {{ post.tags | join: ', ' | jsonify }},
      "content"  : {{ post.content | strip_html | strip_newlines | jsonify }},
      "url"      : {{ post.url | prepend: site.baseurl | jsonify }},
      "date"     : {{ post.date | jsonify }},
      "type"     : "post"
    }{% if site.notes.size > 0 or forloop.last == false %},{% endif %}
  {% endfor %}
  {% assign notes = site.notes | sort: "date" | reverse %}
  {% for note in notes %}
    {% assign note_title = note.title | remove_first: note.course | remove_first: "：" | remove_first: ": " | remove_first: ":" %}
    {
      "title"    : {{ note_title | jsonify }},
      "subtitle" : {{ note.course | append: " · " | append: note.subtitle | jsonify }},
      "tags"     : {{ note.tags | join: ', ' | jsonify }},
      "content"  : {{ note.content | strip_html | strip_newlines | jsonify }},
      "course"   : {{ note.course | jsonify }},
      "url"      : {{ note.url | prepend: site.baseurl | jsonify }},
      "date"     : {{ note.date | jsonify }},
      "type"     : "note"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
