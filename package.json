{
  "name": "cloudingyu-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "notes:sync": "node scripts/sync-notebook.mjs",
    "notes:inventory": "node course-notes/workflow.mjs inventory",
    "notes:status": "node course-notes/workflow.mjs status",
    "notes:prepare": "node course-notes/workflow.mjs prepare",
    "notes:validate": "node course-notes/workflow.mjs validate",
    "notes:publish": "node course-notes/workflow.mjs publish",
    "notes:check": "node course-notes/workflow.mjs check",
    "notes:test": "node --test course-notes/workflow.test.mjs",
    "vendor": "node scripts/vendor-katex.mjs",
    "prepare-content": "npm run sync && npm run vendor",
    "dev": "npm run prepare-content && astro dev",
    "start": "npm run prepare-content && astro dev",
    "build": "npm run prepare-content && npm run notes:check && astro build",
    "preview": "astro preview",
    "check": "npm run prepare-content && npm run notes:check && astro check",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "katex": "^0.18.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1",
    "unist-util-visit": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
