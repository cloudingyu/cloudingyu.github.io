---
import ExperimentalLayout from './ExperimentalLayout.astro';
import { SITE, PAGES } from '../data/site';
import type { PageKey } from '../data/site';
import '../styles/prose.css';
import '../styles/interior.css';
import '../styles/reading.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  tags?: string[];
  image?: string;
  noindex?: boolean;
  author?: string;
  page?: PageKey;
  hero?: 'full' | 'tall' | 'compact' | 'bare';
  showQuote?: boolean;
}
const { title, page = 'home', hero = 'compact', showQuote = hero !== 'bare', ...meta } = Astro.props;
---

<ExperimentalLayout {title} {...meta}>
  <slot name="head" slot="head" />
  <slot name="reading-navigation" slot="reading-navigation" />
  {hero !== 'bare' && (
    <section class:list={['page-opening', { 'page-opening--404': page === 'notFound', 'page-opening--about': page === 'about', 'page-opening--collection': page === 'home' }]} aria-labelledby="page-title">
      <div class="page-opening__type">
        <h1 id="page-title"><slot name="page-title">{title || SITE.title}</slot><span aria-hidden="true">.</span></h1>
        {showQuote && <blockquote class="page-opening__quote">{PAGES[page].quote}</blockquote>}
      </div>
      {page !== 'about' && <div class="page-opening__seal" aria-hidden="true"><div /><span>CY</span></div>}
    </section>
  )}
  <slot />
  <slot name="scripts" slot="scripts" />
</ExperimentalLayout>
