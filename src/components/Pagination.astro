---
/**
 * 分页：每页 6 篇，第 1 页在 /，之后是 /page/2/、/page/3/。
 * 三条都显示出来（总量只有 3 页），当前页用实心方点标出，
 * 不做「上一页 / 下一页」这种需要往返点击才能建立位置感的控件。
 */
import { pageUrl, type Page } from '../lib/posts';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
const nums = Array.from({ length: page.total }, (_, i) => i + 1);
---

{
  page.total > 1 && (
    <nav class="pager" aria-label="文章分页">
      <span class="pager__hint mono-meta">
        第 {page.current} / {page.total} 页
      </span>

      <ul class="pager__list">
        {nums.map((n) => (
          <li>
            {n === page.current ? (
              <span class="pager__num is-current" aria-current="page">
                {String(n).padStart(2, '0')}
              </span>
            ) : (
              <a class="pager__num" href={pageUrl(n)} rel="prev">
                {String(n).padStart(2, '0')}
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="pager__ends">
        {page.prev ? (
          <a class="pager__end" href={pageUrl(page.prev)} rel="prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path d="M19 12H6M12 5.5 5.5 12 12 18.5" />
            </svg>
            <span class="mono-meta">较新</span>
          </a>
        ) : (
          <span class="pager__end is-disabled" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M19 12H6M12 5.5 5.5 12 12 18.5" />
            </svg>
            <span class="mono-meta">较新</span>
          </span>
        )}

        {page.next ? (
          <a class="pager__end" href={pageUrl(page.next)} rel="next">
            <span class="mono-meta">较早</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
            </svg>
          </a>
        ) : (
          <span class="pager__end is-disabled" aria-hidden="true">
            <span class="mono-meta">较早</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M5 12h13M12 5.5 18.5 12 12 18.5" />
            </svg>
          </span>
        )}
      </div>
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s4);
    margin-top: var(--s7);
    padding-top: var(--s5);
    border-top: 1px solid var(--line-strong);
  }

  .pager__hint { color: var(--ink-faint); }

  .pager__list {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pager__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding-inline: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    border: 1px solid transparent;
    transition: color 0.22s var(--ease), border-color 0.22s var(--ease);
  }

  a.pager__num:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  /* 当前页：靛蓝描边 + 墨色数字，不加底色 */
  .pager__num.is-current {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }

  .pager__ends {
    display: flex;
    align-items: center;
    gap: var(--s5);
  }

  .pager__end {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
    transition: color 0.22s var(--ease), gap 0.22s var(--ease);
  }
  .pager__end svg { width: 0.9rem; height: 0.9rem; }
  a.pager__end:hover { color: var(--accent); gap: 0.6rem; }
  .pager__end.is-disabled {
    color: var(--ink-faint);
    opacity: 0.45;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .pager__num, .pager__end { transition: none; }
  }
</style>
