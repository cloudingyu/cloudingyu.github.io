---
import { pageUrl, type Page } from '../lib/posts';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
const nums = Array.from({ length: page.total }, (_, i) => i + 1);
---

{page.total > 1 && (
  <nav class="pager" aria-label="文章分页">
    <ul class="pager__list">
      {nums.map((n) => (
        <li>
          {n === page.current ? (
            <span class="pager__num is-current" aria-current="page" aria-label={`第 ${n} 页`}>
              {String(n).padStart(2, '0')}
            </span>
          ) : (
            <a class="pager__num" href={pageUrl(n)} aria-label={`第 ${n} 页`}>
              {String(n).padStart(2, '0')}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .pager {
    display: flex;
    justify-content: center;
    margin-top: var(--s7);
    padding-top: var(--s5);
  }

  .pager__list {
    display: flex;
    align-items: center;
    gap: .7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pager__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--panel-sunk);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition: color .22s var(--ease), background-color .22s var(--ease), transform .22s var(--ease);
  }

  .pager__num.is-current,
  a.pager__num:hover {
    background: var(--accent);
    color: var(--paper);
  }

  a.pager__num:hover { transform: translateY(-2px); }
  a.pager__num:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .pager__num { transition: none; }
    a.pager__num:hover { transform: none; }
  }
</style>
