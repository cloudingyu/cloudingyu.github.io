---
interface Link { href: string; label: string; title?: string; rel?: string }
interface Props { label?: string; homeHref?: string; homeLabel?: string; neighbors?: Link[] }
const { label = '阅读导航', homeHref = '/', homeLabel = '博客首页', neighbors = [] } = Astro.props;
const prev = neighbors.find((item) => item.rel === 'prev');
const next = neighbors.find((item) => item.rel === 'next');
---

<div class="reading-navigation" data-reading-navigation hidden>
  <button class="reading-navigation__toggle" type="button" data-reading-navigation-toggle aria-label="展开阅读转盘" title="展开阅读转盘" aria-expanded="false" aria-controls="reading-navigation-panel">
    <span class="reading-navigation__sphere" aria-hidden="true">
      <span class="reading-navigation__ring reading-navigation__ring--one" />
      <span class="reading-navigation__ring reading-navigation__ring--two" />
      <span class="reading-navigation__core" />
      <span class="reading-navigation__spark" />
      <span class="reading-navigation__echo" />
    </span>
  </button>
  <nav class="reading-navigation__panel" id="reading-navigation-panel" aria-label={label} data-reading-navigation-panel inert>
    <div class="reading-navigation__dial" aria-hidden="true"><span /><i /><b /></div>
    <a class="reading-navigation__item reading-navigation__item--home" href={homeHref} aria-label={homeLabel} title={homeLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v11h5v-6h4v6h5V9" /></svg>
      <span>主页</span>
    </a>
    {prev ? <a class="reading-navigation__item reading-navigation__item--prev" href={prev.href} rel="prev" aria-label={`${prev.label}：${prev.title}`} title={`${prev.label}：${prev.title}`}>
      <span class="reading-navigation__symbol" aria-hidden="true">‹</span><span>{prev.label}</span>
    </a> : <button class="reading-navigation__item reading-navigation__item--prev" type="button" disabled aria-label="暂无上一篇" title="暂无上一篇">
      <span class="reading-navigation__symbol" aria-hidden="true">‹</span><span>上一篇</span>
    </button>}
    {next ? <a class="reading-navigation__item reading-navigation__item--next" href={next.href} rel="next" aria-label={`${next.label}：${next.title}`} title={`${next.label}：${next.title}`}>
      <span class="reading-navigation__symbol" aria-hidden="true">›</span><span>{next.label}</span>
    </a> : <button class="reading-navigation__item reading-navigation__item--next" type="button" disabled aria-label="暂无下一篇" title="暂无下一篇">
      <span class="reading-navigation__symbol" aria-hidden="true">›</span><span>下一篇</span>
    </button>}
    <button class="reading-navigation__item reading-navigation__item--top" type="button" data-reading-navigation-top aria-label="回到顶部" title="回到顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14M12 20V8m-5 5 5-5 5 5" /></svg>
      <span>顶部</span>
    </button>
    <span class="reading-navigation__caption" aria-hidden="true">NAV</span>
  </nav>
</div>

<style>
  .reading-navigation {
    --orb-size: 3.5rem; --dial-size: 15rem;
    position: fixed; bottom: calc(1.5rem + env(safe-area-inset-bottom)); right: calc(1.25rem + env(safe-area-inset-right));
    z-index: 60; width: var(--orb-size); height: var(--orb-size); transform-origin: center;
    animation: orb-arrive .46s cubic-bezier(.22, 1, .36, 1) both;
  }
  .reading-navigation[hidden] { display: none; }
  .reading-navigation[data-leaving] { pointer-events: none; animation: orb-depart .3s cubic-bezier(.4, 0, 1, 1) both; }
  .reading-navigation__toggle { position: relative; z-index: 2; display: grid; place-items: center; width: 100%; height: 100%; padding: .25rem; border: 0; border-radius: 50%; touch-action: manipulation; }
  .reading-navigation__sphere { position: relative; display: block; width: 100%; height: 100%; }
  .reading-navigation__core {
    position: absolute; inset: .2rem; border-radius: 50%;
    background: var(--accent);
    transition: transform .35s var(--exp-ease), background .3s;
  }
  .reading-navigation__core::after { content: ''; position: absolute; inset: 30%; border: 1px solid var(--paper); border-radius: 50%; }
  .reading-navigation__ring { position: absolute; inset: -.12rem; border: 1px solid color-mix(in srgb, var(--exp-purple) 65%, transparent); border-radius: 50%; transition: transform .75s var(--exp-ease), border-color .4s; }
  .reading-navigation__ring--one { border-style: dashed; transform: rotate(-32deg); animation: orb-ring-settle .46s ease-out backwards; }
  .reading-navigation__ring--two { inset: .05rem; transform: rotate(48deg); }
  .reading-navigation__spark { position: absolute; top: 12%; right: 11%; width: .3rem; height: .3rem; border-radius: 50%; background: var(--paper); transition: transform .75s var(--exp-ease); }
  .reading-navigation__echo { position: absolute; inset: -.08rem; border: 1px solid var(--accent); border-radius: 50%; opacity: 0; pointer-events: none; animation: orb-ripple .46s ease-out backwards; }
  .reading-navigation[data-leaving] .reading-navigation__echo { animation: orb-ripple-depart .3s ease-out both; }
  .reading-navigation__toggle:focus-visible .reading-navigation__core { transform: scale(1.08); background: var(--exp-purple); }
  .reading-navigation__toggle:focus-visible .reading-navigation__ring--one { transform: rotate(55deg) scale(1.18); border-color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .reading-navigation__toggle:hover .reading-navigation__core { transform: scale(1.08); background: var(--exp-purple); }
    .reading-navigation__toggle:hover .reading-navigation__ring--one { transform: rotate(55deg) scale(1.18); border-color: var(--accent); }
    .reading-navigation__toggle:hover .reading-navigation__ring--two { transform: rotate(-42deg) scale(1.06); border-color: var(--accent); }
    .reading-navigation__toggle:hover .reading-navigation__spark { transform: translate(-.65rem, .4rem); }
  }
  .reading-navigation[data-open] .reading-navigation__core { transform: scale(.85) rotate(155deg); background: var(--exp-purple); }
  .reading-navigation[data-open] .reading-navigation__ring--one { transform: rotate(155deg); border-color: var(--accent); }
  .reading-navigation[data-open] .reading-navigation__ring--two { transform: rotate(-120deg); }
  .reading-navigation[data-open] .reading-navigation__spark { transform: translate(-1.7rem, 1.7rem); }
  .reading-navigation__panel {
    position: absolute; bottom: 0; right: 0; width: var(--dial-size); height: var(--dial-size);
    border-radius: 50%; border: 1px solid color-mix(in srgb, var(--exp-purple) 35%, var(--line));
    background: var(--panel);
    opacity: 0; visibility: hidden; pointer-events: none; transform-origin: calc(100% - var(--orb-size) / 2) calc(100% - var(--orb-size) / 2);
    transform: rotate(100deg) scale(.05);
    transition: transform .65s var(--exp-ease), opacity .25s .12s, visibility 0s .65s;
  }
  .reading-navigation[data-open] .reading-navigation__panel { opacity: 1; visibility: visible; pointer-events: auto; transform: rotate(0) scale(1); transition: transform .75s cubic-bezier(.16, 1.12, .3, 1), opacity .2s, visibility 0s; }
  .reading-navigation__dial { position: absolute; inset: .65rem; border: 1px solid var(--line); border-radius: 50%; pointer-events: none; }
  .reading-navigation__dial::before { content: ''; position: absolute; inset: 23%; border: 1px dashed color-mix(in srgb, var(--exp-purple) 45%, transparent); border-radius: 50%; }
  .reading-navigation__dial span { position: absolute; inset: -.4rem; border-radius: 50%; border: 2px solid transparent; border-top-color: var(--accent); border-bottom-color: var(--exp-purple); transform: rotate(0); transition: transform 1s var(--exp-ease); }
  .reading-navigation[data-open] .reading-navigation__dial span { transform: rotate(225deg); }
  .reading-navigation__dial :is(i, b) { position: absolute; inset: 15% 50%; width: 1px; background: var(--line); }
  .reading-navigation__dial b { transform: rotate(90deg); }
  .reading-navigation__item {
    --delay: 0ms;
    position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem;
    width: 3.5rem; height: 3.5rem; padding: .25rem; border: 1px solid transparent; border-radius: 50%;
    background: var(--panel); color: var(--ink); font-size: .6rem; line-height: 1.3; font-weight: 550; white-space: nowrap;
    opacity: 0; transform: translate(-50%, -50%) rotate(-65deg) scale(.5);
    transition: transform .5s var(--exp-ease), opacity .2s, background .2s, color .2s;
  }
  .reading-navigation[data-open] .reading-navigation__item { opacity: 1; transform: translate(-50%, -50%) rotate(0) scale(1); transition-delay: var(--delay), var(--delay), 0s, 0s; }
  .reading-navigation__item--home { left: 50%; top: 81%; --delay: 220ms; }
  .reading-navigation__item--prev { left: 19%; top: 50%; --delay: 120ms; }
  .reading-navigation__item--next { left: 81%; top: 50%; --delay: 170ms; }
  .reading-navigation__item--top { left: 50%; top: 19%; --delay: 70ms; }
  .reading-navigation__item svg { width: 1.5rem; height: 1.5rem; }
  .reading-navigation__symbol { display: flex; align-items: center; justify-content: center; height: 1.5rem; font: 400 2.4rem/.65 Arial, sans-serif; }
  .reading-navigation__item:not(:disabled):hover, .reading-navigation__item:focus-visible { background: var(--accent); color: var(--paper); }
  .reading-navigation__item:disabled { color: var(--ink-faint); cursor: default; }
  .reading-navigation__item:disabled > * { opacity: .3; }
  .reading-navigation__caption { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: .3rem; background: var(--panel); color: var(--ink-muted); font: 500 .55rem var(--font-mono); letter-spacing: .12em; pointer-events: none; }
  @keyframes orb-arrive {
    0% { opacity: 0; transform: translate(.35rem, .6rem) scale(.82); }
    65% { opacity: 1; transform: translate(0, -.06rem) scale(1.04); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes orb-ring-settle {
    0% { opacity: .2; transform: rotate(-85deg) scale(.9); }
    100% { opacity: 1; transform: rotate(-32deg) scale(1); }
  }
  @keyframes orb-ripple {
    0% { opacity: 0; transform: scale(.85); }
    35% { opacity: .5; }
    100% { opacity: 0; transform: scale(1.35); }
  }
  @keyframes orb-depart {
    0% { opacity: 1; transform: none; }
    25% { opacity: 1; transform: scale(1.02); }
    100% { opacity: 0; transform: translate(0, .25rem) scale(.82); }
  }
  @keyframes orb-ripple-depart {
    0% { opacity: .5; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.45); }
  }
  @media (max-width: 48rem) {
    .reading-navigation { --dial-size: 14rem; bottom: calc(1rem + env(safe-area-inset-bottom)); right: calc(1rem + env(safe-area-inset-right)); }
  }
  @media (max-height: 20rem) {
    .reading-navigation { --dial-size: 12rem; bottom: calc(.75rem + env(safe-area-inset-bottom)); }
    .reading-navigation__item { width: 3rem; height: 3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-navigation, .reading-navigation * { animation: none !important; }
    .reading-navigation :is(.reading-navigation__core, .reading-navigation__ring, .reading-navigation__spark, .reading-navigation__panel, .reading-navigation__dial span, .reading-navigation__item) { transition: none; }
  }
</style>
