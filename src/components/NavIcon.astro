---
interface Props { name: 'articles' | 'about' | 'archive' | 'search' }
const { name } = Astro.props;
const paths = {
  articles: ['M5 3h14v18H5z', 'M9 7h6M9 12h6M9 17h4'],
  about: ['M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0', 'M4 21v-2a8 8 0 0 1 16 0v2'],
  archive: ['M3 3h18v5H3z', 'M5 8v13h14V8M10 12h4'],
  search: ['M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0', 'm15 15 6 6'],
};
---
<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
<style>
  .nav-icon { display: block; width: 1.1em; height: 1.1em; flex-shrink: 0; }
</style>
