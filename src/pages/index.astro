---
import Arrow from '../components/Arrow.astro';
import AsciiHero from '../components/AsciiHero.astro';
import ExperimentalLayout from '../layouts/ExperimentalLayout.astro';
import Pagination from '../components/Pagination.astro';
import PostPoster from '../components/PostPoster.astro';
import { allPosts, paginate, tagCounts, formatDate, permalink } from '../lib/posts';
import { SITE, POSTS_PER_PAGE } from '../data/site';
import { NOTEBOOK_PATH } from '../data/notebook-config.mjs';

const posts = await allPosts();
const [first] = paginate(posts, POSTS_PER_PAGE);
const latest = posts[0]!;
const tags = tagCounts(posts);
---

<ExperimentalLayout description={SITE.description}>
  <div class="home-stage">
  <section class="exp-hero" data-exp-hero aria-labelledby="hero-title">
    <div class="hero-type">
      <h1 id="hero-title"><span class="hero-line"><span>保持</span></span><span class="hero-line hero-line--acid"><span>好奇<span class="hero-period"><span aria-hidden="true">。</span><button class="hero-period__trigger" type="button" data-notebook-entrance={`${NOTEBOOK_PATH}/`} aria-label="双击进入课程笔记"></button></span></span></span></h1>
      <p>算法、设计与未完成的探索。</p>
      <a class="hero-cta" href="#index" data-magnet><span>进入文章</span><span aria-hidden="true"><Arrow direction="down-right" /></span></a>
    </div>

    <AsciiHero />
    <button class="hero-morph" type="button" data-morph aria-label="切换为鱼" disabled><svg class="hero-morph__symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 8a8 8 0 0 0-13-2L4 9m0-5v5h5M4 16a8 8 0 0 0 13 2l3-3m0 5v-5h-5" /></svg></button>

    <a class="latest-dock" href={permalink(latest)}>
      <div><span class="latest-dock__badge">最新文章</span><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time></div>
      <h2>{latest.data.title}</h2><span class="latest-dock__arrow" aria-hidden="true"><Arrow /></span>
    </a>
  </section>

  <div class="signal-band" aria-hidden="true"><div class="signal-band__offset"><div class="signal-band__track">{Array.from({ length: 4 }, () => <span>STAY CURIOUS <svg class="signal-band__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" /></svg> MAKE SOMETHING <svg class="signal-band__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" /></svg> KEEP EXPLORING <svg class="signal-band__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" /></svg></span>)}</div></div></div>
  </div>

  <section class="exp-journal" id="index" aria-labelledby="journal-title">
    <div class="journal-heading" data-exp-reveal><h2 id="journal-title">博客<span>与笔记</span></h2><a href="/page/1/">全部文章 <span aria-hidden="true"><Arrow /></span></a></div>
    <div class="journal-list">
      {first.items.map((post, i) => <PostPoster {post} index={i} headingLevel="h3" />)}
    </div>
    <Pagination page={first} />
  </section>

  <section class="exp-topics" aria-labelledby="topics-title">
    <div class="topics-heading"><h2 id="topics-title" data-exp-reveal>按<span>主题</span>阅读</h2></div>
    <div class="topic-flow"><div class="topic-flow__track">{tags.map(({ tag, count }) => <a href={`/tags/${encodeURIComponent(tag)}/`}><span class="topic-flow__label">{tag}<sup>{count}</sup></span><span class="topic-flow__arrow" aria-hidden="true"><Arrow /></span></a>)}{tags.map(({ tag, count }) => <a href={`/tags/${encodeURIComponent(tag)}/`} aria-hidden="true" tabindex="-1"><span class="topic-flow__label">{tag}<sup>{count}</sup></span><span class="topic-flow__arrow"><Arrow /></span></a>)}</div></div>
  </section>
</ExperimentalLayout>

<script>import '../scripts/notebook-entrance.js';</script>

<style>
  .home-stage { --home-link-size: 1.375rem; display: grid; grid-template-rows: minmax(0, 1fr) auto; height: calc(100dvh - var(--exp-nav-height)); min-height: 0; }
  .exp-hero { --hero-progress: 0; position: relative; display: flex; align-items: center; min-height: 0; padding: 1.5rem var(--exp-space); isolation: isolate; overflow: clip; }
  .exp-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; background: radial-gradient(ellipse at 74% 44%, color-mix(in srgb, var(--exp-purple) 9%, transparent), transparent 48%); }
  .hero-type { position: relative; z-index: 3; width: 54%; pointer-events: none; transform: translateY(calc(var(--hero-progress) * -145px)); opacity: calc(1 - var(--hero-progress) * .65); }
  .hero-type, .hero-type h1, .hero-line, .hero-line > span { background: transparent; box-shadow: none; backdrop-filter: none; }
  .hero-line:first-child { translate: calc(var(--hero-progress) * -72px) 0; }
  .hero-line--acid { translate: calc(var(--hero-progress) * 110px) 0; }
  .hero-type h1 { font-size: clamp(4.5rem, min(11.3vw, 19svh), 11rem); font-weight: 900; line-height: 1.1; letter-spacing: -.08em; font-family: var(--font-sans); }
  .hero-line { display: block; overflow: clip; padding: .03em .08em .06em 0; margin-bottom: -.05em; }
  .hero-line > span { display: block; }
  .hero-line--acid { color: var(--accent); }
  .hero-type h1 { user-select: none; -webkit-user-select: none; }
  .hero-period { position: relative; display: inline-block; width: .5em; color: var(--exp-purple); margin-left: .12em; letter-spacing: 0; -webkit-touch-callout: none; }
  .hero-period__trigger { position: absolute; left: -.015em; bottom: .025em; width: .32em; height: .32em; padding: 0; border: 0; border-radius: 50%; background: transparent; font: inherit; pointer-events: auto; touch-action: manipulation; }
  .hero-type p { font-size: 1.1875rem; line-height: 1.9; margin: 1.5rem 0; color: var(--ink-soft); letter-spacing: .02em; }
  .hero-type p > span { color: var(--ink-muted); }
  .hero-cta { pointer-events: auto; display: inline-flex; align-items: center; justify-content: space-between; gap: 2.8rem; background: var(--accent); color: var(--paper); font-size: var(--home-link-size); font-weight: 700; padding: 1rem 1.4rem; border-radius: 3rem; translate: var(--mag-x, 0px) var(--mag-y, 0px); transition: scale .3s var(--exp-ease); }
  .hero-cta > span:last-child { font-size: 1.4rem; line-height: 1; }
  .hero-cta:hover { scale: 1.04; }
  .hero-morph { --morph-fill: var(--exp-purple-deep); --morph-ink: #f0f1e9; position: absolute; z-index: 5; right: 10%; bottom: 13rem; display: grid; place-items: center; width: 3.4rem; height: 3.4rem; color: var(--morph-ink); padding: 0; border: 2px solid var(--morph-fill); border-radius: 50%; background: var(--morph-fill); transition: background .3s, color .3s, border-color .3s, filter .3s; }
  :global([data-theme='light']) .hero-morph { --morph-fill: #d0ff45; --morph-ink: #15170f; }
  .hero-morph__symbol { display: block; width: 1.5rem; height: 1.5rem; transition: rotate .6s var(--exp-ease); }
  .hero-morph:is(:hover, :focus-visible) { filter: brightness(1.08); }
  .hero-morph:is(:hover, :focus-visible) .hero-morph__symbol { rotate: 180deg; }
  .hero-morph:disabled { display: none; }
  @media (prefers-reduced-motion: reduce) { .hero-morph__symbol { transition: none; } }
  .latest-dock { position: absolute; z-index: 5; bottom: 2rem; right: var(--exp-space); width: min(38%, 28rem); padding: 1.25rem 3.7rem 1.25rem 0; border: 0; border-top: 1px solid var(--line-strong); background: transparent; translate: calc(var(--hero-progress) * -25px) calc(var(--hero-progress) * -50px); transition: border-color .3s; }
  .latest-dock:hover { border-color: var(--accent); color: var(--accent); }
  .latest-dock > div { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; font: var(--home-link-size)/1.5 var(--font-sans); color: var(--ink-muted); margin-bottom: .7rem; }
  .latest-dock__badge { color: var(--accent); font-weight: 600; }
  .latest-dock h2 { font-size: var(--home-link-size); font-weight: 600; line-height: 1.5; letter-spacing: 0; }
  .latest-dock__arrow { position: absolute; right: 1.4rem; bottom: 1.5rem; color: var(--accent); font-size: 1.5rem; }
  .signal-band { position: relative; overflow: hidden; padding-block: .65rem; background: #d0ff45; color: #10120b; }
  .signal-band__offset { transform: translateX(calc(var(--signal-offset, 0) * -1px)); width: max-content; }
  .signal-band__track { display: flex; width: max-content; font-family: 'Arial Black', var(--font-sans); font-size: clamp(1.1rem, 2.7vw, 2.5rem); line-height: 1.2; font-weight: 900; letter-spacing: -.04em; }
  .signal-band__track > span { display: flex; align-items: center; gap: 2rem; padding-right: 2rem; }
  .signal-band__mark { display: block; flex: 0 0 auto; width: 1.4em; height: 1.4em; }
  .exp-journal { padding: 6rem var(--exp-space) 5rem; overflow-x: clip; }
  .journal-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.8rem; }
  .journal-heading h2 { font-size: clamp(2.75rem, 6vw, 6rem); font-weight: 800; letter-spacing: -.065em; }
  .journal-heading h2 span { color: var(--accent); }
  .journal-heading > a { flex-shrink: 0; padding-bottom: .6rem; font-size: 1.375rem; font-weight: 600; }
  .journal-heading > a span { margin-left: 2rem; color: var(--accent); }
  .journal-list { display: grid; grid-template-columns: minmax(0, 1fr); }
  .exp-journal :global(.pager) { margin-top: 2.5rem; }
  .exp-topics { padding: 4rem 0 5rem; overflow: hidden; }
  .topics-heading { padding-inline: var(--exp-space); margin-bottom: 2rem; }
  .topics-heading h2 { font-size: clamp(2.7rem, 6vw, 6rem); line-height: 1.1; font-weight: 800; letter-spacing: -.06em; }
  .topics-heading h2 span { color: var(--exp-purple); }
  .topic-flow { overflow: hidden; padding-block: .75rem; }
  .topic-flow__track { display: flex; width: max-content; gap: 1rem; padding-right: 1rem; }
  .topic-flow a { display: flex; align-items: center; gap: 2rem; flex-shrink: 0; border: 1px solid var(--line-strong); border-radius: 5rem; padding: 1.1rem 2rem; font-size: clamp(1.2rem, 2.8vw, 2.5rem); font-weight: 600; transition: background .3s, color .3s, rotate .4s var(--exp-ease); }
  .topic-flow__label { display: inline-flex; align-items: start; gap: .18em; }
  .topic-flow a sup { align-self: start; color: var(--ink-muted); font: 600 1.25rem/1.3 var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: 0; margin-top: .15em; }
  .topic-flow__arrow { color: var(--accent); font-size: 1.2rem; }
  .topic-flow a:hover { background: var(--accent); color: var(--paper); rotate: -3deg; }
  .topic-flow a:hover :is(sup, span) { color: inherit; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-morph[aria-busy='true'] .hero-morph__symbol { animation: morph-working .8s linear infinite; }
    .hero-line > span { animation: giant-rise .75s var(--exp-ease) both; }
    .hero-line--acid > span { animation-delay: .08s; }
    .hero-cta { animation-delay: .5s; }
    .latest-dock { animation-delay: .7s; }
    .signal-band__track { animation: signal-run 28s linear infinite; }
    .topic-flow__track { animation: topics-run 80s linear infinite; }
    .topic-flow:hover .topic-flow__track, .topic-flow:focus-within .topic-flow__track { animation-play-state: paused; }
    .signal-band[data-motion-paused] .signal-band__track, .topic-flow[data-motion-paused] .topic-flow__track { animation-play-state: paused; }
  }
  @keyframes giant-rise { from { transform: translateY(115%) rotate(4deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes morph-working { to { rotate: 360deg; } }
  @keyframes details-rise { from { transform: translateY(20px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes scroll-pulse { 0%, 100% { translate: 0 -3px; } 50% { translate: 0 4px; } }
  @keyframes signal-run { to { transform: translateX(-25%); } }
  @keyframes topics-run { to { transform: translateX(-50%); } }
  @media (min-width: 48.01rem) {
    .latest-dock h2 { text-wrap: wrap; }
  }
  @media (max-width: 64rem) {
    .hero-type h1 { font-size: clamp(4.5rem, min(12vw, 19svh), 8rem); }
  }
  @media (max-width: 48rem) {
    .home-stage { --home-link-size: 1.25rem; }
    .exp-hero { padding-block: 1rem; }
    .hero-type { width: 80%; align-self: flex-start; padding-top: clamp(1rem, 4svh, 2rem); transform: translateY(calc(var(--hero-progress) * -95px)); }
    .hero-line:first-child { translate: calc(var(--hero-progress) * -38px) 0; }
    .hero-line--acid { translate: calc(var(--hero-progress) * 62px) 0; }
    .hero-type h1 { font-size: clamp(3.5rem, min(18vw, 13svh), 7rem); }
    .hero-type p { font-size: 1.0625rem; margin-top: 1rem; }
    .hero-cta { padding: .85rem 1.2rem; gap: 2rem; }
    .hero-morph { top: auto; bottom: 11rem; right: 6%; width: 3rem; height: 3rem; }
    .latest-dock { width: auto; left: var(--exp-space); bottom: 1rem; right: var(--exp-space); padding: 1rem 3.5rem 1rem 0; }
    .signal-band { padding-block: .7rem; }
    .signal-band__track > span { gap: 1rem; padding-right: 1rem; }
    .exp-journal { padding-top: 3.5rem; padding-bottom: 3.5rem; }
    .journal-heading { margin-bottom: 1.5rem; gap: 1rem; }
    .journal-heading > a { font-size: 1.25rem; }
    .journal-heading > a span { margin-left: .75rem; }
    .exp-topics { padding-block: 3rem; }
    .topic-flow a sup { font-size: 1.125rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-type { transform: none; }
    .topic-flow { overflow-x: auto; }
    .topic-flow__track { width: max-content; }
    .topic-flow a[aria-hidden] { display: none; }
  }
  .home-stage:has([data-ascii-stacked]) { height: auto; min-height: calc(100dvh - var(--exp-nav-height)); grid-template-rows: auto auto; }
  .exp-hero[data-ascii-stacked] { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1.25rem; padding-block: 1.5rem; }
  .exp-hero[data-ascii-stacked] .hero-type { width: 100%; padding-top: 0; align-self: auto; }
  .exp-hero[data-ascii-stacked] .latest-dock { position: relative; inset: auto; width: 100%; margin: 0; }
  @media (max-width: 48rem) {
    .home-stage { height: auto; min-height: calc(100dvh - var(--exp-nav-height)); grid-template-rows: auto auto; }
    .exp-hero { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1.25rem; padding-block: 1.5rem; }
    .hero-type { width: 100%; padding-top: 0; align-self: auto; }
    .latest-dock { position: relative; inset: auto; width: 100%; margin: 0; }
  }
  @media (max-width: 24rem) {
    .hero-morph { right: var(--exp-space); }
  }
  @media (min-width: 48.01rem) and (max-height: 38rem) {
    .exp-hero { padding-block: .5rem; }
    .hero-type h1 { font-size: clamp(2.5rem, 12dvh, 5rem); }
    .hero-type p { font-size: 1.125rem; margin-block: .6rem; }
    .hero-cta { padding-block: .7rem; }
    .latest-dock { bottom: .75rem; padding-block: .75rem; }
  }
</style>
