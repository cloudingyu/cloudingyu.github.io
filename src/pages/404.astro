---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../data/site';
---

<BaseLayout page="notFound" hero="bare" title="404">
  <section class="notfound" aria-labelledby="notfound-title">
    <h1 id="notfound-title">404</h1>
    <p>{PAGES.notFound.quote}</p>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: calc(100svh - var(--exp-nav-height));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem var(--exp-space);
    text-align: center;
  }
  .notfound h1 {
    margin: 0;
    color: var(--exp-purple);
    font-size: clamp(6rem, 18vw, 14rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -.05em;
  }
  .notfound p {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.8;
  }
</style>