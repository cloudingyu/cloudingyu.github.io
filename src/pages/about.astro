---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, AUTHOR } from '../data/site';
import { assetUrl } from '../lib/posts';


---

<BaseLayout
  page="about"
  hero="compact"
  title="关于"
  description={`关于 ${SITE.title} 的作者与这个站点。`}
>
  <div class="shell about">
    <div class="about__grid">
      <div class="about__main reveal">
        <h2 class="about__h">
          你好, 我是 CloudingYu <span class="about__wave" aria-hidden="true">👋</span>
        </h2>

        <h3 class="about__h3">🚀 关于我</h3>
        <ul class="about__list">
          <li>💡 喜欢用优雅的代码简化复杂问题并解决实际问题</li>
          <li>🖥️ FDUSC 队员，正在学习 AI Infra 相关知识</li>
          <li>📚 终身学习者，始终保持好奇心</li>
          <li>🎓 复旦大学本科生</li>
        </ul>

        <figure class="about__divider" aria-hidden="true">
          <p class="about__manifesto">BUILD. BREAK. LEARN.</p>
        </figure>

        <blockquote class="about__quote">
          "Curiosity is the spark that lights the flame of our journey, but it is not enough to
          illuminate the entire path"
        </blockquote>

      </div>


      <aside class="about__aside" aria-label="作者头像" data-exp-reveal>
        <img class="about__portrait" src={assetUrl(AUTHOR.avatar)} alt={AUTHOR.name} width="256" height="256" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding-top: var(--s6);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s7);
    padding-top: var(--s7);
  }
  @media (min-width: 62rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: var(--s8);
    }
  }

  .about__main { min-width: 0; }

  .about__h {
    font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.3rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 0 0 var(--s6);
  }

  .about__wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.6s var(--ease) infinite;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    68% { transform: rotate(16deg); }
    76% { transform: rotate(-8deg); }
    84% { transform: rotate(12deg); }
    92% { transform: rotate(-4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .about__wave { animation: none; }
  }

  .about__h3 {
    font-size: 1.15rem;
    margin: var(--s7) 0 var(--s4);
    padding-top: var(--s4);
    color: var(--ink);
  }

  .about__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .about__list li {
    position: relative;
    padding-left: 0;
    margin-bottom: 0.6rem;
    color: var(--ink-soft);
    transition: transform 0.3s var(--ease), color 0.3s var(--ease);
  }
  /* 悬停时那一条往右挪一点，像被指尖拨过 */
  .about__list li:hover {
    transform: translateX(4px);
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .about__list li, .about__list li::before { transition: none; }
  }

  /* --- 几何分隔带（替代原来的 Giphy 动图） --- */

  .about__divider {
    position: relative;
    height: clamp(7rem, 14vw, 10rem);
    margin: var(--s6) 0;
    overflow: hidden;
  }

  .scene--inline {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(60% 120% at 50% 50%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(60% 120% at 50% 50%, #000 40%, transparent 100%);
  }

  .about__quote {
    margin: var(--s6) 0;
    padding: 0 var(--s4);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-muted);
    line-height: 1.9;
    max-width: 42ch;
    margin-inline: auto;
    text-align: center;
    border: 0;
  }

  /* 侧栏仅展示头像。 */
  .about__aside { align-self: start; }
  @media (min-width: 62rem) {
    .about__aside { position: sticky; top: 3rem; }
  }
</style>
