---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { SITE, AUTHOR } from '../data/site';
import { assetUrl } from '../lib/posts';
import '../styles/about.css';

---

<BaseLayout page="about" hero="compact" title="关于" description={`关于 ${SITE.title} 的作者与这个站点。`}>
  <div class="shell about" data-about>
    <section class="about-profile" aria-labelledby="about-hello">
      <div class="about-profile__intro">
        <h2 id="about-hello" class="about-hello" data-exp-reveal>
          你好, 我是<br />
          <span class="about-name">CloudingYu<span class="about-name__dot">.</span></span>
        </h2>
        <h3 class="about-section-label" data-exp-reveal>关于我 <span aria-hidden="true"><Arrow direction="down-right" /></span></h3>
        <div class="about-mosaic">
          <section class="about-tile about-tile--explore" aria-labelledby="about-explore" data-exp-reveal>
            <h4 id="about-explore">AI<br />INFRA<span aria-hidden="true"><Arrow /></span></h4>
            <p>FDUSC 队员，正在学习 AI Infra 相关知识</p>
            <span class="about-tile__track" aria-hidden="true" />
          </section>
          <section class="about-tile about-tile--fudan" aria-labelledby="about-fudan" data-exp-reveal>
            <h4 id="about-fudan">FUDAN</h4>
            <p>复旦大学 · 计算与智能创新学院 · 本科生</p>
            <span class="about-tile__seal" aria-hidden="true" />
          </section>
          <section class="about-tile about-tile--curiosity" aria-labelledby="about-curiosity" data-exp-reveal>
            <div><h4 id="about-curiosity">好奇心，没有终点。</h4><p>终身学习者，始终保持好奇心</p></div>
            <svg class="about-tile__infinity" viewBox="0 0 120 60" fill="none" aria-hidden="true" focusable="false"><path d="M60 30C40 0 8 0 8 30s32 30 52 0c20-30 52-30 52 0S80 60 60 30Z" stroke="currentColor" stroke-width="2" /></svg>
          </section>
        </div>
      </div>

      <aside class="about-art" aria-label="作者头像与灵感轨道" data-about-art data-phase="0" data-exp-reveal>
        <div class="about-art__space" aria-hidden="true">
          <div class="about-art__grid" />
          <div class="about-art__halo" />
          <div class="about-art__tilt">
            <div class="about-orbit about-orbit--outer"><i /><i /></div>
            <div class="about-orbit about-orbit--one"><i /></div>
            <div class="about-orbit about-orbit--two"><i /></div>
            <div class="about-art__cross about-art__cross--one">+</div>
            <div class="about-art__cross about-art__cross--two">+</div>
            <span class="about-art__tag about-art__tag--one">&lt; CODE /&gt;</span>
            <span class="about-art__tag about-art__tag--two">AI INFRA</span>
            <span class="about-art__tag about-art__tag--three">好奇心 ∞</span>
          </div>
        </div>
        <button class="about-portrait-button" type="button" data-about-trigger aria-label="点亮灵感，切换到 BREAK" disabled>
          <img class="about-avatar" src={assetUrl(AUTHOR.avatar)} alt={AUTHOR.name} width="256" height="256" />
          <span class="about-portrait-button__ring" aria-hidden="true" />
        </button>
        <div class="about-art__sparks" aria-hidden="true" />
        <div class="about-art__caption">
          <p class="about-art__mode" aria-live="polite" aria-atomic="true"><span data-about-word>BUILD.</span> <span data-about-caption>把想法写成代码</span></p>
        </div>
      </aside>
    </section>

    <section class="about-manifesto" aria-label="BUILD. BREAK. LEARN.">
      <p class="about-manifesto__line" data-exp-reveal aria-hidden="true"><span>BUILD.</span><span>BREAK.</span><span>LEARN<svg class="about-manifesto__star" viewBox="0 0 40 40" fill="none" focusable="false"><path d="M20 2v36M2 20h36M7 7l26 26M7 33 33 7" stroke="currentColor" stroke-width="2.5" /></svg></span></p>
    </section>
  </div>
  <script>import '../scripts/about-effects.js';</script>
</BaseLayout>
