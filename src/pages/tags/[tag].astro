---
/**
 * 单个标签的文章列表：/tags/<标签>/
 *
 * 标签是中英混排的（题解 / 洛谷 … 与 VSCode / Vim / IDE），中文标签在 URL 里
 * 会变成百分号编码。getStaticPaths 的 params 拿到的是解码后的原值，
 * 所以这里直接用 tag 本身做 key、用 encodeURIComponent 生成链接，两边一致。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, tagCounts } from '../../lib/posts';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await allPosts();
  const tags = tagCounts(posts);
  return tags.map((t) => ({
    params: { tag: t.tag },
    props: {
      tag: t.tag,
      count: t.count,
      featured: t.featured,
      // 只把属于该标签的文章传下去
      items: posts.filter((p) => p.data.tags.includes(t.tag)),
      totalTags: tags.length,
    },
  }));
}

interface Props {
  tag: string;
  count: number;
  featured: boolean;
  items: CollectionEntry<'posts'>[];
  totalTags: number;
}

const { tag, count, items, totalTags } = Astro.props;
---

<BaseLayout
  page="archive"
  hero="compact"
  title={tag}
  description={`标签「${tag}」下的 ${count} 篇文章。`}
>
  <section class="shell tagpage">
    <p class="tagpage__lead">
      <a class="tagpage__back mono-meta" href="/archive/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M19 12H6M12 5.5 5.5 12 12 18.5" />
        </svg>
        全部标签
      </a>
      <span class="mono-meta tagpage__count">
        {count} 篇 · 共 {totalTags} 个标签
      </span>
    </p>

    <div class="tagpage__list">
      {items.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .tagpage { padding-top: var(--s6); }

  .tagpage__lead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s3) var(--s5);
    margin-bottom: var(--s2);
  }

  .tagpage__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
    transition: color 0.22s var(--ease), gap 0.22s var(--ease);
  }
  .tagpage__back svg { width: 0.85rem; height: 0.85rem; }
  .tagpage__back:hover { color: var(--accent); gap: 0.6rem; }

  .tagpage__count { color: var(--ink-faint); }

  .tagpage__list > :last-child { border-bottom: 1px solid var(--line); }
</style>
